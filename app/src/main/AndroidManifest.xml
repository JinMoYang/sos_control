<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Cloud offload over the lab LAN, plain HTTP to a local server IP. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Rotation Start reuses the diagnostic app's ~200-400 Hz quaternion/gyro trigger. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <!-- Drive mode reports scheme changes by vibration so the driver never looks down. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Optional: with All files access granted (phone workflow), runs land in
         Documents/sos where a file manager can see them. Without it the app still
         records into its private directory — RayNeo never grants this. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- TFLite GPU API 2.16 has an old library manifest that causes these legacy permissions
         to be implied. The RayNeo app neither needs nor requests them. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE"
        tools:node="remove" />

    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.raw" android:required="true" />
    <!-- Only the AE mode drives autofocus; every other mode captures manually. -->
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ActivePerception"
        android:usesCleartextTraffic="true">
        <!-- Required for RayNeo X-series launcher / Explore app discovery. -->
        <meta-data
            android:name="com.rayneo.mercury.app"
            android:value="true" />

        <!-- configChanges keeps the Activity alive across rotation; MeasurementActivity
             reflows the layout itself so the camera and model are not reloaded. -->
        <activity
            android:name=".MeasurementActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
