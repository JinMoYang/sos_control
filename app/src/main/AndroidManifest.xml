<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Cloud offload over the lab LAN, plain HTTP to a local server IP. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Puts runs in Documents/sos/ where a file manager can see them. Without it the
         app still records, but only into its private directory. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Sensors are sampled at SENSOR_DELAY_GAME (~50 Hz), which is below the threshold that
         would require HIGH_SAMPLING_RATE_SENSORS. -->

    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <!-- Only the AE mode drives autofocus; every other mode captures manually. -->
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ActivePerception"
        android:usesCleartextTraffic="true">
        <!-- configChanges keeps the Activity alive across rotation; MeasurementActivity
             reflows the layout itself so the camera and model are not reloaded. -->
        <activity
            android:name=".MeasurementActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>